# Configuracion de ejemplo para Mercamigo.
# Copia este archivo como .env (o exporta las variables en tu terminal) y
# reemplaza los valores por los de TU proyecto de Supabase.
#
# La clave publicable (publishable / anon) esta disenada para viajar dentro de
# la app: la seguridad real la aplican las politicas RLS del servidor.
# NUNCA pongas aqui la clave service_role, la contrasena de PostgreSQL ni
# secretos de administrador.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICABLE
